<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WHG | لوحة الإدارة والإحصائيات</title>
    <link rel="icon" type="image/png" href="https://cdn.discordapp.com/attachments/1482157841136484538/1571222972436324442/whg-new-logo.png?ex=6b032d6c&is=6b01dbec&hm=38171f2b07caec8ff75ca9eed1e7320e748120947ae7cc124a1a33231d9faaa3&">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #070708;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(180, 142, 92, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(180, 142, 92, 0.06) 0%, transparent 45%);
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0c0c0e; }
        ::-webkit-scrollbar-thumb { background: #3f3324; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #b48e5c; }
    </style>
</head>
<body class="text-zinc-100 min-h-screen p-4 md:p-8 selection:bg-[#b48e5c] selection:text-black">

<% if (!authenticated) { %>
    <div class="min-h-[85vh] flex items-center justify-center">
        <div class="bg-[#0e0e11]/95 backdrop-blur-xl border border-[#b48e5c]/30 p-8 md:p-10 rounded-3xl max-w-md w-full shadow-[0_0_50px_rgba(180,142,92,0.12)] text-center relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-[#b48e5c] to-transparent"></div>
            
            <div class="relative w-28 h-28 mx-auto mb-5">
                <div class="absolute inset-0 rounded-full bg-[#b48e5c]/20 blur-xl"></div>
                <img src="https://cdn.discordapp.com/attachments/1482157841136484538/1571222972436324442/whg-new-logo.png?ex=6b032d6c&is=6b01dbec&hm=38171f2b07caec8ff75ca9eed1e7320e748120947ae7cc124a1a33231d9faaa3&" alt="WHG Logo" class="relative w-28 h-28 rounded-full object-cover border-2 border-[#b48e5c] shadow-lg mx-auto">
            </div>

            <span class="inline-block text-xs font-bold tracking-widest uppercase text-[#b48e5c] bg-[#b48e5c]/10 border border-[#b48e5c]/20 px-3 py-1 rounded-full mb-2">
                WHG ADMINISTRATION
            </span>
            <h1 class="text-2xl font-extrabold text-white mb-1">بوابة الإدارة المركزية</h1>
            <p class="text-sm text-zinc-400 mb-7">أدخل رمز الدخول للوصول إلى لوحة التحكم</p>

            <form onsubmit="submitLogin(event)" class="space-y-4">
                <input type="password" id="passcodeInput" placeholder="••••••••" autofocus
                       class="w-full bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-3.5 rounded-xl text-center text-xl tracking-[0.3em] text-white outline-none transition">
                <p id="loginError" class="text-red-400 text-sm hidden font-semibold"></p>
                <button type="submit" class="w-full bg-gradient-to-r from-[#9e7b4d] via-[#b48e5c] to-[#9e7b4d] hover:brightness-110 text-black font-extrabold py-3.5 rounded-xl shadow-lg shadow-[#b48e5c]/20 transition">
                    دخول اللوحة
                </button>
            </form>
        </div>
    </div>

    <script>
        async function submitLogin(e) {
            e.preventDefault();
            const passcode = document.getElementById('passcodeInput').value.trim();
            const errEl = document.getElementById('loginError');
            errEl.classList.add('hidden');

            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ passcode })
            });
            const data = await res.json();

            if (data.success) location.reload();
            else {
                errEl.innerText = data.message || 'الرمز غير صحيح';
                errEl.classList.remove('hidden');
                document.getElementById('passcodeInput').value = '';
            }
        }
    </script>

<% } else { %>
    <div class="max-w-7xl mx-auto">
        <!-- الهيدر العلوي -->
        <header class="bg-[#0e0e11]/90 backdrop-blur-md border border-zinc-800/90 rounded-2xl p-4 md:p-5 mb-6 flex flex-wrap items-center justify-between gap-4 shadow-xl">
            <div class="flex items-center gap-4">
                <img src="https://cdn.discordapp.com/attachments/1482157841136484538/1571222972436324442/whg-new-logo.png?ex=6b032d6c&is=6b01dbec&hm=38171f2b07caec8ff75ca9eed1e7320e748120947ae7cc124a1a33231d9faaa3&" alt="WHG" class="w-14 h-14 rounded-full object-cover border-2 border-[#b48e5c] shadow-[0_0_15px_rgba(180,142,92,0.3)]">
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl md:text-2xl font-black text-white tracking-wide">WHG</h1>
                        <span class="text-xs font-bold bg-[#b48e5c]/15 text-[#d4af7a] border border-[#b48e5c]/30 px-2.5 py-0.5 rounded-md">لوحة الإدارة</span>
                    </div>
                    <p class="text-xs text-zinc-400 mt-0.5">نظام إدارة شؤون الإداريين، الساعات، التفعيلات والحزم</p>
                </div>
            </div>

            <button onclick="logout()" class="bg-[#16161a] hover:bg-red-950/40 hover:text-red-400 hover:border-red-500/40 text-zinc-300 px-4 py-2.5 rounded-xl text-sm font-bold border border-zinc-800 transition flex items-center gap-2">
                <span>🔒</span>
                <span>قفل اللوحة</span>
            </button>
        </header>

        <!-- أزرار التنقل -->
        <div class="flex flex-wrap gap-3 mb-7 bg-[#0e0e11] p-2 rounded-2xl border border-zinc-800/80">
            <button onclick="showTab('staff')" id="btn-staff" class="bg-[#b48e5c] text-black px-5 py-2.5 rounded-xl font-extrabold text-sm transition shadow-md">
                👥 الموظفين والساعات (<%= staffList.length %>)
            </button>
            <button onclick="showTab('packages')" id="btn-packages" class="bg-transparent hover:bg-zinc-800/70 text-zinc-300 px-5 py-2.5 rounded-xl font-bold text-sm transition">
                📦 الحزم (<%= packages.length %>)
            </button>
            <button onclick="showTab('activations')" id="btn-activations" class="bg-transparent hover:bg-zinc-800/70 text-zinc-300 px-5 py-2.5 rounded-xl font-bold text-sm transition">
                ✅ التفعيل (<%= activations.length %>)
            </button>
            <button onclick="showTab('blacklist')" id="btn-blacklist" class="bg-transparent hover:bg-zinc-800/70 text-zinc-300 px-5 py-2.5 rounded-xl font-bold text-sm transition">
                🚫 البلاك ليست (<%= blacklist.length %>)
            </button>
            <button onclick="showTab('audit')" id="btn-audit" class="bg-transparent hover:bg-zinc-800/70 text-zinc-300 px-5 py-2.5 rounded-xl font-bold text-sm transition">
                📜 سجل العمليات (محمي)
            </button>
        </div>

        <!-- تبويب الموظفين -->
        <div id="tab-staff" class="tab-content">
            <div class="bg-[#0e0e11] p-4 rounded-2xl border border-zinc-800/90 mb-6 flex flex-wrap items-center justify-between gap-4 shadow-lg">
                <div class="flex flex-wrap items-center gap-2.5">
                    <input type="text" id="staffIdInput" placeholder="ضع Copy ID للإداري هنا..." class="bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-60 text-sm text-white outline-none transition">
                    <button onclick="addStaff()" class="bg-[#b48e5c] hover:bg-[#c69f6b] text-black px-4 py-2.5 rounded-xl font-extrabold text-sm transition shadow">
                        + إضافة إداري
                    </button>
                    <button onclick="resetAllStaffHours()" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 px-4 py-2.5 rounded-xl font-bold text-sm transition">
                        🔄 تصفير ساعات الجميع
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <input type="text" id="staffSearchInput" oninput="filterStaff()" placeholder="🔍 بحث باليوزر أو اسم FiveM أو الآيدي..." class="bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-72 text-sm text-white outline-none transition">
                    <select id="staffSortSelect" onchange="filterStaff()" class="bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl text-sm text-white outline-none transition">
                        <option value="default">الترتيب الافتراضي</option>
                        <option value="most">الأكثر ساعات ⬆️</option>
                        <option value="least">الأقل ساعات ⬇️</option>
                    </select>
                </div>
            </div>

            <div id="staffGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% staffList.forEach(s => { 
                    const totalMins = s.totalMinutes || 0;
                    const totalHrs = Math.floor(totalMins / 60);
                    const remMins = totalMins % 60;
                %>
                    <div onclick="openDetailsModal(this)" 
                         data-id="<%= s.discordId %>" 
                         data-username="<%= s.username %>" 
                         data-avatar="<%= s.avatar %>"
                         data-fivem="<%= s.fivemName || '' %>"
                         data-notes="<%= s.extraNotes || '' %>"
                         data-minutes="<%= totalMins %>"
                         class="staff-card bg-[#0e0e11] p-5 rounded-2xl border border-zinc-800/90 hover:border-[#b48e5c]/70 hover:shadow-[0_0_25px_rgba(180,142,92,0.1)] cursor-pointer transition relative overflow-hidden group">
                        
                        <div class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-transparent via-[#b48e5c]/50 to-transparent opacity-0 group-hover:opacity-100 transition"></div>

                        <% if (s.inSupport) { %>
                            <div class="mb-3.5 flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-xl">
                                <span class="relative flex h-2.5 w-2.5">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                                </span>
                                <span class="text-xs text-emerald-400 font-bold truncate">متواجد في: <%= s.channelName %></span>
                            </div>
                        <% } %>

                        <div class="flex items-start justify-between gap-2 mb-4">
                            <div class="flex items-center gap-3.5">
                                <img src="<%= s.avatar %>" class="w-13 h-13 rounded-full border-2 border-[#b48e5c] shrink-0 object-cover">
                                <div>
                                    <h3 class="font-bold text-base text-white flex flex-wrap items-center gap-2">
                                        <span><%= s.username %></span>
                                        <% if (s.fivemName) { %>
                                            <span class="text-xs bg-[#b48e5c]/15 text-[#d4af7a] border border-[#b48e5c]/30 px-2 py-0.5 rounded-md font-semibold"><%= s.fivemName %></span>
                                        <% } %>
                                    </h3>
                                    <p class="text-xs text-[#d4af7a] font-bold mt-1">
                                        ⏱️ <%= totalHrs %> ساعة و <%= remMins %> دقيقة
                                    </p>
                                </div>
                            </div>
                            <div class="flex flex-col gap-1.5 shrink-0">
                                <button onclick="event.stopPropagation(); resetStaffHours('<%= s.discordId %>', '<%= s.username %>')" title="تصفير ساعات" class="bg-amber-500/10 hover:bg-amber-500/25 text-amber-400 border border-amber-500/20 px-2.5 py-1 rounded-lg text-xs font-bold transition">
                                    🔄 تصفير
                                </button>
                                <button onclick="event.stopPropagation(); openRemoveModal('<%= s.discordId %>', '<%= s.username %>')" class="bg-red-500/10 hover:bg-red-500/25 text-red-400 border border-red-500/20 px-2.5 py-1 rounded-lg text-xs font-bold transition">
                                    حذف
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2.5 mb-3.5 bg-[#151519] p-2.5 rounded-xl border border-zinc-800/80 text-center">
                            <div>
                                <p class="text-[11px] text-zinc-400">التفعيلات</p>
                                <p class="text-sm font-extrabold text-emerald-400 mt-0.5"><%= s.activationsCount %> 👤</p>
                            </div>
                            <div class="border-r border-zinc-800">
                                <p class="text-[11px] text-zinc-400">الحزم</p>
                                <p class="text-sm font-extrabold text-[#d4af7a] mt-0.5"><%= s.packagesCount %> 📦</p>
                            </div>
                        </div>

                        <!-- تفاصيل الجلسات اليومية بالساعات والدقائق -->
                        <div class="border-t border-zinc-800/80 pt-3 max-h-28 overflow-y-auto space-y-1.5">
                            <% if ((s.sessions || []).length === 0) { %>
                                <p class="text-xs text-zinc-600 text-center py-2">لا توجد جلسات مسجلة</p>
                            <% } else { %>
                                <% (s.sessions || []).forEach(sess => { 
                                    const sMins = sess.minutes || 0;
                                    const sHrs = Math.floor(sMins / 60);
                                    const sRem = sMins % 60;
                                    const formattedTime = sHrs > 0 ? `${sHrs} ساعة و ${sRem} دقيقة` : `${sRem} دقيقة`;
                                %>
                                    <div class="flex justify-between items-center text-xs bg-[#151519] px-3 py-1.5 rounded-lg border border-zinc-800/50">
                                        <span class="text-zinc-400"><%= sess.date %></span>
                                        <span class="text-[#d4af7a] font-bold"><%= formattedTime %></span>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
            <p id="noStaffMsg" class="hidden text-center text-zinc-500 py-10 font-semibold">لا يوجد إداري مطابق لبحثك.</p>
        </div>

        <!-- تبويب الحزم -->
        <div id="tab-packages" class="tab-content hidden">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-extrabold text-white flex items-center gap-2">
                        <span class="text-[#b48e5c]">📦</span> سجل الحزم
                    </h2>
                    <button id="pkgClearFilterBtn" onclick="clearStaffFilter('packages')" class="hidden bg-[#b48e5c]/15 hover:bg-[#b48e5c]/25 text-[#d4af7a] border border-[#b48e5c]/30 px-3 py-1 rounded-lg text-xs font-bold transition">
                        ✕ إلغاء فلترة الإداري
                    </button>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <input type="text" id="pkgSearchInput" oninput="filterPackages()" placeholder="🔍 بحث بيوزر الشخص أو الإداري..." class="bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-72 text-sm text-white outline-none transition">
                    <select id="pkgFilterSelect" onchange="filterPackages()" class="bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl text-sm text-white outline-none transition">
                        <option value="all">جميع الحزم</option>
                        <option value="حزمة بلاتينيوم">💎 حزمة بلاتينيوم</option>
                        <option value="حزمة تيتانيوم">⚡ حزمة تيتانيوم</option>
                        <option value="حزمة زحف">🚀 حزمة زحف</option>
                    </select>
                </div>
            </div>

            <div class="bg-[#0e0e11] rounded-2xl border border-zinc-800/90 overflow-hidden shadow-xl">
                <table class="w-full text-right">
                    <thead class="bg-[#151519] text-zinc-300 text-sm border-b border-zinc-800">
                        <tr><th class="p-3.5">الشخص</th><th class="p-3.5">الحزمة</th><th class="p-3.5">الإداري</th><th class="p-3.5">السبب</th><th class="p-3.5">الوقت</th></tr>
                    </thead>
                    <tbody id="packagesTableBody" class="divide-y divide-zinc-800/70 text-sm">
                        <% if(packages.length === 0) { %>
                            <tr><td colspan="5" class="p-6 text-center text-zinc-500">لا توجد حزم مسجلة حتى الآن</td></tr>
                        <% } else { %>
                            <% packages.forEach(p => { %>
                                <tr class="pkg-row hover:bg-zinc-900/50 transition" data-user="<%= p.username %>" data-staff="<%= p.staffName %>" data-pkg="<%= p.packageName %>">
                                    <td class="p-3.5 font-bold text-white"><%= p.username %></td>
                                    <td class="p-3.5 text-[#d4af7a] font-bold"><%= p.packageName %></td>
                                    <td class="p-3.5">
                                        <button onclick="filterByStaffName('packages', '<%= p.staffName %>')" title="فلترة حسب هذا الإداري" class="text-zinc-200 hover:text-[#d4af7a] underline decoration-[#b48e5c]/40 underline-offset-4 font-semibold transition">
                                            <%= p.staffName %>
                                        </button>
                                    </td>
                                    <td class="p-3.5 text-zinc-400"><%= p.reason %></td>
                                    <td class="p-3.5 text-xs text-zinc-500"><%= p.date %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
                <p id="noPkgMsg" class="hidden p-6 text-center text-zinc-500">لا توجد نتائج مطابقة للبحث.</p>
            </div>
        </div>

        <!-- تبويب التفعيل -->
        <div id="tab-activations" class="tab-content hidden">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-extrabold text-white flex items-center gap-2">
                        <span class="text-[#b48e5c]">✅</span> سجل التفعيل
                    </h2>
                    <button id="actClearFilterBtn" onclick="clearStaffFilter('activations')" class="hidden bg-[#b48e5c]/15 hover:bg-[#b48e5c]/25 text-[#d4af7a] border border-[#b48e5c]/30 px-3 py-1 rounded-lg text-xs font-bold transition">
                        ✕ إلغاء فلترة الإداري
                    </button>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <input type="text" id="actSearchInput" oninput="filterActivations()" placeholder="🔍 بحث باليوزر أو الاسم العسكري أو الإداري..." class="bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-72 text-sm text-white outline-none transition">
                    <select id="actSectorSelect" onchange="filterActivations()" class="bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl text-sm text-white outline-none transition">
                        <option value="all">جميع القطاعات</option>
                        <option value="أمن الطرق">أمن الطرق</option>
                        <option value="الشرطة">الشرطة</option>
                        <option value="المرور">المرور</option>
                        <option value="دوريات الأمن">دوريات الأمن</option>
                    </select>
                </div>
            </div>

            <div class="bg-[#0e0e11] rounded-2xl border border-zinc-800/90 overflow-hidden shadow-xl">
                <table class="w-full text-right">
                    <thead class="bg-[#151519] text-zinc-300 text-sm border-b border-zinc-800">
                        <tr><th class="p-3.5">العضو</th><th class="p-3.5">الاسم العسكري</th><th class="p-3.5">القطاع</th><th class="p-3.5">الإداري</th><th class="p-3.5">الوقت</th></tr>
                    </thead>
                    <tbody id="activationsTableBody" class="divide-y divide-zinc-800/70 text-sm">
                        <% if(activations.length === 0) { %>
                            <tr><td colspan="5" class="p-6 text-center text-zinc-500">لا توجد عمليات تفعيل مسجلة حتى الآن</td></tr>
                        <% } else { %>
                            <% activations.forEach(a => { %>
                                <tr class="act-row hover:bg-zinc-900/50 transition" data-user="<%= a.username %>" data-nick="<%= a.nickname %>" data-staff="<%= a.staffName %>" data-sector="<%= a.sector %>">
                                    <td class="p-3.5 font-bold text-white"><%= a.username %></td>
                                    <td class="p-3.5 text-[#d4af7a] font-bold"><%= a.nickname %></td>
                                    <td class="p-3.5 text-zinc-300"><%= a.sector %></td>
                                    <td class="p-3.5">
                                        <button onclick="filterByStaffName('activations', '<%= a.staffName %>')" title="فلترة حسب هذا الإداري" class="text-zinc-200 hover:text-[#d4af7a] underline decoration-[#b48e5c]/40 underline-offset-4 font-semibold transition">
                                            <%= a.staffName %>
                                        </button>
                                    </td>
                                    <td class="p-3.5 text-xs text-zinc-500"><%= a.date %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
                <p id="noActMsg" class="hidden p-6 text-center text-zinc-500">لا توجد نتائج مطابقة للبحث.</p>
            </div>
        </div>

        <!-- تبويب البلاك ليست -->
        <div id="tab-blacklist" class="tab-content hidden">
            <div class="bg-[#0e0e11] p-4 rounded-2xl border border-zinc-800/90 mb-6 flex flex-wrap items-center justify-between gap-4 shadow-lg">
                <div class="flex flex-wrap items-center gap-2.5 flex-1">
                    <input type="text" id="blacklistIdInput" placeholder="ضع Copy ID هنا..." class="bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-64 text-sm text-white outline-none transition">
                    <input type="text" id="blacklistReasonInput" placeholder="السبب (اختياري)..." class="bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl w-72 text-sm text-white outline-none transition">
                    <button onclick="addToBlacklist()" class="bg-red-600 hover:bg-red-500 text-white px-4 py-2.5 rounded-xl font-extrabold text-sm transition shadow">
                        🚫 إضافة للبلاك ليست
                    </button>
                </div>
                <p class="text-xs text-zinc-400">أي شخص مضاف هنا يتم رفض تفعيله تلقائياً في بوت التفعيل.</p>
            </div>

            <div class="bg-[#0e0e11] rounded-2xl border border-zinc-800/90 overflow-hidden shadow-xl">
                <table class="w-full text-right">
                    <thead class="bg-[#151519] text-zinc-300 text-sm border-b border-zinc-800">
                        <tr>
                            <th class="p-3.5">العضو</th>
                            <th class="p-3.5">Copy ID</th>
                            <th class="p-3.5">السبب</th>
                            <th class="p-3.5">التاريخ</th>
                            <th class="p-3.5">إجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/70 text-sm">
                        <% if(blacklist.length === 0) { %>
                            <tr><td colspan="5" class="p-6 text-center text-zinc-500">لا يوجد أشخاص في البلاك ليست حالياً</td></tr>
                        <% } else { %>
                            <% blacklist.forEach(b => { %>
                                <tr class="hover:bg-zinc-900/50 transition">
                                    <td class="p-3.5 font-bold text-white"><%= b.username %></td>
                                    <td class="p-3.5 font-mono text-[#d4af7a]"><%= b.discordId %></td>
                                    <td class="p-3.5 text-zinc-300"><%= b.reason || 'بدون سبب' %></td>
                                    <td class="p-3.5 text-xs text-zinc-500"><%= b.date %></td>
                                    <td class="p-3.5">
                                        <button onclick="removeFromBlacklist('<%= b.discordId %>', '<%= b.username %>')" class="bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-lg text-xs font-bold transition">
                                            فك البلاك ليست
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- تبويب سجل العمليات -->
        <div id="tab-audit" class="tab-content hidden">
            <% if (!auditAuth) { %>
                <div class="bg-[#0e0e11] border border-[#b48e5c]/30 p-8 rounded-3xl max-w-md w-full mx-auto my-12 text-center shadow-2xl">
                    <div class="w-16 h-16 bg-[#b48e5c]/15 text-[#d4af7a] rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 border border-[#b48e5c]/30">
                        🔒
                    </div>
                    <h2 class="text-xl font-extrabold text-white mb-1">سجل العمليات محمي</h2>
                    <p class="text-sm text-zinc-400 mb-6">أدخل رمز الدخول الخاص بسجل العمليات لعرض السجلات</p>

                    <form onsubmit="submitAuditLogin(event)" class="space-y-4">
                        <input type="password" id="auditPassInput" placeholder="••••••••" autofocus
                               class="w-full bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-3.5 rounded-xl text-center text-lg tracking-[0.3em] text-white outline-none transition">
                        <p id="auditLoginError" class="text-red-400 text-sm hidden font-semibold"></p>
                        <button type="submit" class="w-full bg-[#b48e5c] hover:bg-[#c69f6b] text-black font-extrabold py-3 rounded-xl transition">
                            فتح السجل
                        </button>
                    </form>
                </div>
            <% } else { %>
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-extrabold text-white flex items-center gap-2">
                        <span class="text-[#b48e5c]">📜</span> سجل الحركات والعمليات الإدارية
                    </h2>
                    <span class="text-xs font-bold text-[#d4af7a] bg-[#b48e5c]/15 px-3 py-1.5 rounded-xl border border-[#b48e5c]/30">مفتوح بأمان 🔓</span>
                </div>

                <div class="bg-[#0e0e11] rounded-2xl border border-zinc-800/90 overflow-hidden shadow-xl">
                    <table class="w-full text-right">
                        <thead class="bg-[#151519] text-zinc-300 text-sm border-b border-zinc-800">
                            <tr><th class="p-3.5">نوع الحركة</th><th class="p-3.5">التفاصيل</th><th class="p-3.5">الوقت</th></tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/70 text-sm">
                            <% if(auditLogs.length === 0) { %>
                                <tr><td colspan="3" class="p-6 text-center text-zinc-500">لا توجد عمليات مسجلة حتى الآن</td></tr>
                            <% } else { %>
                                <% auditLogs.forEach(log => { %>
                                    <tr class="hover:bg-zinc-900/50 transition">
                                        <td class="p-3.5 font-bold text-[#d4af7a]"><%= log.action %></td>
                                        <td class="p-3.5 text-zinc-300"><%= log.details %></td>
                                        <td class="p-3.5 text-xs text-zinc-500"><%= log.date %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- نافذة تفاصيل الإداري + تعديل الدقائق يدوياً -->
    <div id="detailsModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50">
        <div class="bg-[#0e0e11] border border-[#b48e5c]/40 p-6 rounded-3xl max-w-md w-full mx-4 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center gap-4 mb-5 border-b border-zinc-800 pb-4">
                <img id="detAvatar" src="" class="w-14 h-14 rounded-full border-2 border-[#b48e5c] object-cover">
                <div>
                    <h3 id="detUsername" class="text-xl font-extrabold text-white"></h3>
                    <p class="text-xs text-zinc-400 mt-0.5">ID: <span id="detDiscordId" class="font-mono text-[#d4af7a]"></span></p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-zinc-300 mb-1.5">🎮 الاسم في FiveM</label>
                    <input type="text" id="detFivemInput" placeholder="اكتب اسم الإداري داخل السيرفر..." class="w-full bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-3 rounded-xl text-sm text-white outline-none transition">
                </div>

                <div class="bg-[#151519] border border-zinc-800/90 p-3.5 rounded-2xl space-y-3">
                    <label class="block text-sm font-bold text-[#d4af7a]">⏱️ تعديل الساعات / الدقائق يدوياً</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <input type="number" id="detAdjustMinsInput" placeholder="مثال: 30 أو -15" class="w-full bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl text-sm text-white outline-none transition">
                        <input type="text" id="detAdjustReasonInput" placeholder="سبب التعديل..." class="w-full bg-[#0e0e11] border border-zinc-800 focus:border-[#b48e5c] p-2.5 rounded-xl text-sm text-white outline-none transition">
                    </div>
                    <p class="text-[11px] text-zinc-400">اكتب رقم موجب للإضافة (مثلاً 60 = ساعة) أو سالب للخصم (مثلاً -30).</p>
                </div>

                <div>
                    <label class="block text-sm font-bold text-zinc-300 mb-1.5">📝 تفاصيل إضافية <span class="text-zinc-500 font-normal">(اختياري)</span></label>
                    <textarea id="detNotesInput" rows="3" placeholder="أضف أي ملاحظات أو تفاصيل إضافية هنا..." class="w-full bg-[#16161a] border border-zinc-800 focus:border-[#b48e5c] p-3 rounded-xl text-sm text-white outline-none resize-none transition"></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button onclick="saveStaffDetails()" class="flex-1 bg-[#b48e5c] hover:bg-[#c69f6b] text-black font-extrabold py-2.5 px-4 rounded-xl transition">
                    💾 حفظ التفاصيل
                </button>
                <button onclick="closeDetailsModal()" class="bg-[#16161a] hover:bg-zinc-800 text-zinc-300 font-bold py-2.5 px-5 rounded-xl border border-zinc-800 transition">
                    إغلاق
                </button>
            </div>
        </div>
    </div>

    <!-- نافذة خيارات حذف الإداري -->
    <div id="removeModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50">
        <div class="bg-[#0e0e11] border border-zinc-800 p-6 rounded-3xl max-w-md w-full mx-4 shadow-2xl">
            <h3 class="text-xl font-extrabold text-white mb-2">إزالة الإداري: <span id="modalStaffName" class="text-[#d4af7a]"></span></h3>
            <p class="text-zinc-400 text-sm mb-6">سيتم سحب رتبة الإدارة تلقائياً. اختر الإجراء والرتبة التي تريد منحها للعضو:</p>
            
            <div class="space-y-3">
                <button onclick="confirmRemove('thanks')" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition">
                    <span>🏅</span>
                    <span>شكراً لخدمتك الإدارية</span>
                </button>
                <button onclick="confirmRemove('ban')" class="w-full bg-red-600 hover:bg-red-500 text-white font-extrabold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition">
                    <span>🚫</span>
                    <span>محظور من دخول الإدارة</span>
                </button>
                <button onclick="closeRemoveModal()" class="w-full bg-[#16161a] hover:bg-zinc-800 text-zinc-300 font-bold py-2.5 px-4 rounded-xl mt-2 border border-zinc-800 transition">
                    إلغاء
                </button>
            </div>
        </div>
    </div>

    <script>
        let selectedStaffId = null;
        let currentDetailsId = null;

        async function logout() {
            await fetch('/api/logout', { method: 'POST' });
            location.reload();
        }

        function showTab(t) { 
            document.querySelectorAll('.tab-content').forEach(e => e.classList.add('hidden')); 
            document.getElementById('tab-' + t).classList.remove('hidden'); 
            
            const defaultClass = 'bg-transparent hover:bg-zinc-800/70 text-zinc-300 px-5 py-2.5 rounded-xl font-bold text-sm transition';
            const activeClass = 'bg-[#b48e5c] text-black px-5 py-2.5 rounded-xl font-extrabold text-sm transition shadow-md';

            ['staff', 'packages', 'activations', 'blacklist', 'audit'].forEach(tab => {
                document.getElementById('btn-' + tab).className = defaultClass;
            });
            
            document.getElementById('btn-' + t).className = activeClass;
        }

        // فلترة الجداول بالضغط على اسم الإداري
        function filterByStaffName(type, staffName) {
            if (type === 'packages') {
                document.getElementById('pkgSearchInput').value = staffName;
                document.getElementById('pkgClearFilterBtn').classList.remove('hidden');
                filterPackages();
            } else if (type === 'activations') {
                document.getElementById('actSearchInput').value = staffName;
                document.getElementById('actClearFilterBtn').classList.remove('hidden');
                filterActivations();
            }
        }

        function clearStaffFilter(type) {
            if (type === 'packages') {
                document.getElementById('pkgSearchInput').value = '';
                document.getElementById('pkgClearFilterBtn').classList.add('hidden');
                filterPackages();
            } else if (type === 'activations') {
                document.getElementById('actSearchInput').value = '';
                document.getElementById('actClearFilterBtn').classList.add('hidden');
                filterActivations();
            }
        }

        async function addToBlacklist() {
            const discordId = document.getElementById('blacklistIdInput').value.trim();
            const reason = document.getElementById('blacklistReasonInput').value.trim();
            if (!discordId) return alert('الرجاء وضع Copy ID أولاً');

            const res = await fetch('/api/blacklist/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ discordId, reason })
            });
            const data = await res.json();
            if (data.success) location.reload();
            else alert(data.message || 'تعذر الإضافة');
        }

        async function removeFromBlacklist(id, username) {
            if (!confirm(`هل أنت متأكد من فك البلاك ليست عن (${username})؟`)) return;
            await fetch('/api/blacklist/remove/' + id, { method: 'DELETE' });
            location.reload();
        }

        async function submitAuditLogin(e) {
            e.preventDefault();
            const passcode = document.getElementById('auditPassInput').value.trim();
            const errEl = document.getElementById('auditLoginError');
            errEl.classList.add('hidden');

            const res = await fetch('/api/audit/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ passcode })
            });
            const data = await res.json();

            if (data.success) location.reload();
            else {
                errEl.innerText = data.message || 'الرمز غير صحيح';
                errEl.classList.remove('hidden');
                document.getElementById('auditPassInput').value = '';
            }
        }

        async function resetStaffHours(id, username) {
            if (!confirm(`هل أنت متأكد من تصفير ساعات الإداري (${username})؟`)) return;
            await fetch('/api/staff/reset/' + id, { method: 'POST' });
            location.reload();
        }

        async function resetAllStaffHours() {
            if (!confirm('⚠️ هل أنت متأكد من تصفير ساعات جميع الإداريين؟ لا يمكن التراجع عن هذا الإجراء!')) return;
            await fetch('/api/staff/reset-all', { method: 'POST' });
            location.reload();
        }

        function filterStaff() {
            const query = document.getElementById('staffSearchInput').value.toLowerCase().trim();
            const sortVal = document.getElementById('staffSortSelect').value;
            const grid = document.getElementById('staffGrid');
            const cards = Array.from(grid.getElementsByClassName('staff-card'));
            let visibleCount = 0;

            cards.forEach(card => {
                const username = card.dataset.username.toLowerCase();
                const fivem = card.dataset.fivem.toLowerCase();
                const id = card.dataset.id.toLowerCase();

                if (username.includes(query) || fivem.includes(query) || id.includes(query)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            if (sortVal === 'most') {
                cards.sort((a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes));
                cards.forEach(c => grid.appendChild(c));
            } else if (sortVal === 'least') {
                cards.sort((a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes));
                cards.forEach(c => grid.appendChild(c));
            }

            document.getElementById('noStaffMsg').classList.toggle('hidden', visibleCount > 0 || cards.length === 0);
        }

        function filterPackages() {
            const query = document.getElementById('pkgSearchInput').value.toLowerCase().trim();
            const pkgType = document.getElementById('pkgFilterSelect').value;
            const rows = document.querySelectorAll('.pkg-row');
            let visibleCount = 0;

            if (!query) document.getElementById('pkgClearFilterBtn').classList.add('hidden');

            rows.forEach(row => {
                const user = row.dataset.user.toLowerCase();
                const staff = row.dataset.staff.toLowerCase();
                const pkg = row.dataset.pkg;

                if ((user.includes(query) || staff.includes(query)) && (pkgType === 'all' || pkg === pkgType)) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            document.getElementById('noPkgMsg').classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
        }

        function filterActivations() {
            const query = document.getElementById('actSearchInput').value.toLowerCase().trim();
            const sector = document.getElementById('actSectorSelect').value;
            const rows = document.querySelectorAll('.act-row');
            let visibleCount = 0;

            if (!query) document.getElementById('actClearFilterBtn').classList.add('hidden');

            rows.forEach(row => {
                const user = row.dataset.user.toLowerCase();
                const nick = row.dataset.nick.toLowerCase();
                const staff = row.dataset.staff.toLowerCase();
                const rowSector = row.dataset.sector;

                if ((user.includes(query) || nick.includes(query) || staff.includes(query)) && (sector === 'all' || rowSector === sector)) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            document.getElementById('noActMsg').classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
        }

        async function addStaff() {
            let discordId = document.getElementById('staffIdInput').value.trim();
            if (!discordId) return alert('الرجاء وضع الآيدي أولاً');
            let res = await fetch('/api/staff/add', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json' }, 
                body: JSON.stringify({ discordId }) 
            });
            let data = await res.json();
            if (data.success) location.reload(); 
            else alert(data.message || 'خطأ بالآيدي');
        }

        function openDetailsModal(card) {
            currentDetailsId = card.dataset.id;
            document.getElementById('detAvatar').src = card.dataset.avatar;
            document.getElementById('detUsername').innerText = card.dataset.username;
            document.getElementById('detDiscordId').innerText = card.dataset.id;
            document.getElementById('detFivemInput').value = card.dataset.fivem;
            document.getElementById('detNotesInput').value = card.dataset.notes;
            document.getElementById('detAdjustMinsInput').value = '';
            document.getElementById('detAdjustReasonInput').value = '';

            const modal = document.getElementById('detailsModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDetailsModal() {
            currentDetailsId = null;
            const modal = document.getElementById('detailsModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function saveStaffDetails() {
            if (!currentDetailsId) return;
            const fivemName = document.getElementById('detFivemInput').value.trim();
            const extraNotes = document.getElementById('detNotesInput').value.trim();
            const adjustMinutes = document.getElementById('detAdjustMinsInput').value.trim();
            const adjustReason = document.getElementById('detAdjustReasonInput').value.trim();

            const res = await fetch('/api/staff/details/' + currentDetailsId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fivemName, extraNotes, adjustMinutes, adjustReason })
            });
            const data = await res.json();
            if (!data.success) {
                return alert(data.message || 'تعذر حفظ التعديلات');
            }
            location.reload();
        }

        function openRemoveModal(id, username) {
            selectedStaffId = id;
            document.getElementById('modalStaffName').innerText = username;
            const modal = document.getElementById('removeModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeRemoveModal() {
            selectedStaffId = null;
            const modal = document.getElementById('removeModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function confirmRemove(action) {
            if (!selectedStaffId) return;
            await fetch('/api/staff/remove/' + selectedStaffId, { 
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action })
            });
            location.reload();
        }
    </script>
<% } %>

</body>
</html>
